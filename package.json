{
  "name": "@umplabs/truncated-value",
  "version": "0.2.1",
  "description": "A component that intelligently truncates long string values with interactive expansion and full searchability",
  "keywords": [
    "truncate",
    "ellipsis",
    "address",
    "ethereum",
    "web3",
    "react",
    "web-component",
    "lit"
  ],
  "license": "MIT",
  "author": "UMP Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/umpeth/truncated-value.git"
  },
  "bugs": {
    "url": "https://github.com/umpeth/truncated-value/issues"
  },
  "homepage": "https://github.com/umpeth/truncated-value#readme",
  "type": "module",
  "exports": {
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./web-component": {
      "import": {
        "types": "./dist/web-component.d.ts",
        "default": "./dist/web-component.js"
      },
      "require": {
        "types": "./dist/web-component.d.cts",
        "default": "./dist/web-component.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/web-component.js",
    "./dist/web-component.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "size": "size-limit",
    "prepublishOnly": "pnpm build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "lit": "^3.2.0",
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "lit": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^12.0.0",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serve": "^14.2.5",
    "size-limit": "^12.0.0",
    "storybook": "^10.2.2",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.{js,jsx,ts,tsx})": [
      "prettier --write --ignore-unknown"
    ]
  },
  "pnpm": {
    "overrides": {
      "@isaacs/brace-expansion": ">=5.0.1",
      "@babel/core@<=7.29.0": "7.29.6",
      "@humanfs/node@<0.16.8": "0.16.8",
      "ajv@<6.14.0": "6.14.0",
      "ajv@>=7.0.0-alpha.0 <8.18.0": "8.18.0",
      "baseline-browser-mapping@>=2.0.0 <2.11.0": "2.11.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "browserslist@<=4.28.6": "4.28.7",
      "compression@<1.8.2": "1.8.2",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "flatted@<=3.4.1": "3.4.2",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "10.2.3",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "source-map-js@>=1.0.0 <1.2.2": "1.2.2",
      "ws@>=8.0.0 <8.21.0": "8.21.0",
      "yaml@>=2.0.0 <2.8.3": "2.8.3",
      "zod@>=4.0.0 <4.6.6": "4.6.7"
    }
  }
}
